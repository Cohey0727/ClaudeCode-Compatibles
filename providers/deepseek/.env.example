# DeepSeek launcher settings. Every variable here is exported to claude as-is.
# Reference: https://api-docs.deepseek.com/guides/agent_integrations/claude_code
#
# COMMAND is only the installed launcher name (read by `make setup`,
# stripped before claude starts). Naming scheme: claude<name> for Claude
# Code, open<name> for OpenCode.
COMMAND=claudedeepseek

# Optional: default CLI options prepended to every launch (word-split, then
# stripped before claude starts). Explicit options on the command line come
# after these, e.g. CLAUDE_ARGS="--verbose --permission-mode plan"
CLAUDE_ARGS=

# Required: get an API key at https://platform.deepseek.com/
ANTHROPIC_AUTH_TOKEN=

ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_MODEL=deepseek-v4-pro
ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-v4-pro
ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-v4-pro
ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-v4-flash
CLAUDE_CODE_SUBAGENT_MODEL=deepseek-v4-flash
CLAUDE_CODE_EFFORT_LEVEL=max

# ------------------------------------------------------------- OpenCode
# The same token and endpoint also drive an OpenCode launcher (installed
# by `make setup` alongside the Claude Code one). OPENCODE_COMMAND is that
# launcher's name, OPENCODE_ARGS its default CLI options — both stripped
# before opencode starts.
OPENCODE_COMMAND=opendeepseek
OPENCODE_ARGS=

# Model ids OpenCode sends to the API verbatim; the small model handles
# lightweight tasks (title generation etc.).
OPENCODE_MODEL=deepseek-v4-pro
OPENCODE_SMALL_MODEL=deepseek-v4-flash
