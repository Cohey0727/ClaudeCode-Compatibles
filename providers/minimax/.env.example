# MiniMax launcher settings. Every variable here is exported to claude as-is.
#
# COMMAND is only the installed launcher name (read by `make setup`,
# stripped before claude starts). It is "mmxcode", not "minimax" or "mmx":
# both shorter names already exist on a typical machine and would collide —
#   minimax -> ~/.mavis/bin/minimax (official MiniMax Code desktop app)
#   mmx     -> ~/.bun/bin/mmx (unrelated bun-installed tool)
COMMAND=mmxcode

# Optional: default CLI options prepended to every launch (word-split, then
# stripped before claude starts). Explicit options on the command line come
# after these, e.g. CLAUDE_ARGS="--verbose --permission-mode plan"
CLAUDE_ARGS=

# Required: get an API key at https://www.minimax.io/platform
ANTHROPIC_AUTH_TOKEN=

ANTHROPIC_BASE_URL=https://api.minimax.io/anthropic
ANTHROPIC_MODEL=MiniMax-M3
ANTHROPIC_DEFAULT_OPUS_MODEL=MiniMax-M3
ANTHROPIC_DEFAULT_SONNET_MODEL=MiniMax-M3
ANTHROPIC_DEFAULT_HAIKU_MODEL=MiniMax-M3
CLAUDE_CODE_SUBAGENT_MODEL=MiniMax-M3
CLAUDE_CODE_EFFORT_LEVEL=max

# ------------------------------------------------------------- OpenCode
# The same token and endpoint also drive an OpenCode launcher (installed
# by `make setup` alongside the Claude Code one). OPENCODE_COMMAND is that
# launcher's name, OPENCODE_ARGS its default CLI options — both stripped
# before opencode starts. "openmmx" matches the mmxcode naming: the bare
# "mmx" is already taken (~/.bun/bin/mmx).
OPENCODE_COMMAND=openmmx
OPENCODE_ARGS=

# Model ids OpenCode sends to the API verbatim; the small model handles
# lightweight tasks (title generation etc.).
OPENCODE_MODEL=MiniMax-M3
OPENCODE_SMALL_MODEL=MiniMax-M3
