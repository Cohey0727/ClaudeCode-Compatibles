# Local llama.cpp settings. One file drives all three CLIs: Claude Code,
# OpenCode and pi. Every setting below is generic; the commented-out lines
# further down are per-CLI overrides you only need when one CLI should
# differ from the rest.
#
# Unlike the hosted providers there is no account and no key: this points at a
# llama-server running on your own machine. llama-server serves the Anthropic
# shape on /v1/messages, so the launchers talk to it directly.
# Reference: https://github.com/ggml-org/llama.cpp/tree/master/tools/server

# Command names are derived from this: claude<NAME> / pi<NAME>
# -> claudelocal, pilocal.
NAME=local

# llama-server takes no auth. The CLIs still require the variable to be set,
# so any non-empty string works.
API_TOKEN=local

# Anthropic-compatible endpoint, shared by all three CLIs.
#
# Port 11301 is a gate that keeps the LLM off the GPU while a video render is
# running (it forwards to a CPU instance instead), so agent work never kills a
# render. Point BASE_URL at 11302 to always use the GPU.
BASE_URL=http://127.0.0.1:11301

# MODEL fills every main model slot, SMALL_MODEL every cheap one (Claude
# Code's haiku + subagent, OpenCode's small model, pi's second Ctrl+P entry).
# One server serves one model, so both slots are the same id — the value is
# whatever /v1/models reports, which llama-server derives from --alias.
MODEL=huihui-claude47-opus-abliterated
SMALL_MODEL=huihui-claude47-opus-abliterated

# Model limits: pi writes them into its generated models.json, and Claude
# Code takes CONTEXT_WINDOW as its auto-compact window. INPUT is "text" or
# "text,image"; REASONING says whether the models support extended thinking.
#
# CONTEXT_WINDOW must not exceed the server's --ctx-size, or requests fail
# once the conversation grows past it. Both instances behind the gate run at
# the model's own limit, so this is that limit. Filling it on the CPU side is
# slow (~148 tok/s of prompt eval), but llama-server reuses the cached prefix,
# so only the new turns are processed after the first long prompt.
CONTEXT_WINDOW=262144
MAX_TOKENS=32768
REASONING=true
INPUT=text

# Default CLI options prepended to every launch (word-split). Applies to all
# three CLIs; per-CLI overrides are below.
ARGS=

# Claude Code extras, exported as-is. A 35B A3B model on one machine is far
# slower than the hosted providers, so the effort level stays low.
CLAUDE_CODE_EFFORT_LEVEL=low

# --------------------------------------------------------------- overrides
# Everything below is optional — uncomment only to override the defaults
# derived from the settings above.

# Launcher command names. Default: claudelocal / pilocal.
#COMMAND=claudelocal
#PI_COMMAND=pilocal

# Default CLI options per launcher. Default: the value of ARGS.
#CLAUDE_ARGS=--permission-mode plan
#PI_ARGS=--thinking high

# Token and endpoint per launcher. Default: API_TOKEN and BASE_URL.
#ANTHROPIC_AUTH_TOKEN=
#ANTHROPIC_BASE_URL=http://127.0.0.1:11302

# Models per launcher. Default: MODEL for the main slots, SMALL_MODEL for the
# cheap ones. The opus / sonnet / fable slots follow ANTHROPIC_MODEL when set.
#ANTHROPIC_MODEL=huihui-claude47-opus-abliterated
#ANTHROPIC_DEFAULT_HAIKU_MODEL=huihui-claude47-opus-abliterated
#CLAUDE_CODE_SUBAGENT_MODEL=huihui-claude47-opus-abliterated
#OPENCODE_MODEL=huihui-claude47-opus-abliterated
#OPENCODE_SMALL_MODEL=huihui-claude47-opus-abliterated
#PI_MODEL=huihui-claude47-opus-abliterated
#PI_SMALL_MODEL=huihui-claude47-opus-abliterated

# Limits for SMALL_MODEL when it is a different size than MODEL.
# Default: CONTEXT_WINDOW / MAX_TOKENS.
#SMALL_CONTEXT_WINDOW=262144
#SMALL_MAX_TOKENS=32768

# Claude Code's auto-compact window. Default: CONTEXT_WINDOW.
#CLAUDE_CODE_AUTO_COMPACT_WINDOW=262144

# Marker appended to every Claude Code model slot (Claude Code-only syntax).
# Default: none.
#CLAUDE_MODEL_SUFFIX=[1m]
