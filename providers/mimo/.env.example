# MiMo (Xiaomi) launcher settings. Every variable here is exported to claude as-is.
# Reference: https://mimo.mi.com/docs
#
# COMMAND is only the installed launcher name (read by `make setup`,
# stripped before claude starts).
COMMAND=mimo

# Optional: default CLI options prepended to every launch (word-split, then
# stripped before claude starts). Explicit options on the command line come
# after these, e.g. CLAUDE_ARGS="--verbose --permission-mode plan"
CLAUDE_ARGS=

# Required: get a token at https://platform.xiaomimimo.com/token-plan
# Token Plan tokens start with "tp-", pay-as-you-go API keys with "sk-".
ANTHROPIC_AUTH_TOKEN=

# Three endpoints are available:
#   https://token-plan-sgp.xiaomimimo.com/anthropic -> Token Plan subscription, global (default)
#   https://token-plan-cn.xiaomimimo.com/anthropic  -> Token Plan subscription, China accounts
#   https://api.xiaomimimo.com/anthropic            -> pay-as-you-go (metered) billing
# Switch the line below if you use a China account or metered billing.
ANTHROPIC_BASE_URL=https://token-plan-sgp.xiaomimimo.com/anthropic
ANTHROPIC_MODEL=mimo-v2.5-pro[1m]
ANTHROPIC_DEFAULT_OPUS_MODEL=mimo-v2.5-pro[1m]
ANTHROPIC_DEFAULT_SONNET_MODEL=mimo-v2.5-pro[1m]
ANTHROPIC_DEFAULT_HAIKU_MODEL=mimo-v2.5-pro[1m]
ANTHROPIC_DEFAULT_FABLE_MODEL=mimo-v2.5-pro[1m]
CLAUDE_CODE_SUBAGENT_MODEL=mimo-v2.5-pro[1m]
ENABLE_TOOL_SEARCH=false
CLAUDE_CODE_AUTO_COMPACT_WINDOW=1048576
CLAUDE_CODE_EFFORT_LEVEL=max

# ------------------------------------------------------------- OpenCode
# The same token and endpoint also drive an OpenCode launcher (installed
# by `make setup` alongside the Claude Code one). OPENCODE_COMMAND is that
# launcher's name, OPENCODE_ARGS its default CLI options — both stripped
# before opencode starts.
OPENCODE_COMMAND=openmimo
OPENCODE_ARGS=

# Model ids OpenCode sends to the API verbatim — plain ids, no "[1m]"
# (that marker is Claude Code-only syntax). The small model handles
# lightweight tasks (title generation etc.).
OPENCODE_MODEL=mimo-v2.5-pro
OPENCODE_SMALL_MODEL=mimo-v2.5-pro
