# OpenRouter settings, pinned to the Ox Alpha stealth model. One file drives
# all three CLIs: Claude Code, OpenCode and pi. Every setting below is
# generic; the commented-out lines further down are per-CLI overrides you
# only need when one CLI should differ from the rest.
# Reference: https://openrouter.ai/docs/cookbook/coding-agents/claude-code-integration

# The launcher command is derived from this: claude<NAME>
# -> claudeox.
NAME=ox

# Required: get an API key at https://openrouter.ai/settings/keys
API_TOKEN=

# Anthropic-compatible endpoint ("Anthropic skin"), shared by all three CLIs.
# It carries thinking blocks, tool use and streaming through unchanged, so no
# proxy is involved — /api/v1/messages is the same route Claude Code hits
# against Anthropic itself.
BASE_URL=https://openrouter.ai/api

# MODEL fills every main model slot, SMALL_MODEL every cheap one (Claude
# Code's haiku + subagent, OpenCode's small model, pi's second Ctrl+P entry).
# OpenRouter ids carry a vendor prefix; the slash is part of the id, and all
# three CLIs split their "<provider>/<model>" reference on the first slash
# only, so it survives.
MODEL=stealth/ox-alpha
SMALL_MODEL=stealth/ox-alpha

# Model limits: pi writes them into its generated models.json, and Claude
# Code takes CONTEXT_WINDOW as its auto-compact window. INPUT is "text" or
# "text,image"; REASONING says whether the models support extended thinking.
# Ox Alpha also accepts video, which these settings cannot express.
CONTEXT_WINDOW=1048576
MAX_TOKENS=131072
REASONING=true
INPUT=text,image

# Default CLI options prepended to every claude<NAME> launch (word-split).
# OpenCode and pi have no launcher, so this is Claude Code only.
ARGS=

# Claude Code extras, exported as-is.
CLAUDE_CODE_EFFORT_LEVEL=max

# --------------------------------------------------------------- overrides
# Everything below is optional — uncomment only to override the defaults
# derived from the settings above.

# Launcher command name. Default: claudeox.
#COMMAND=claudeox

# Default CLI options for claude<NAME>. Default: the value of ARGS.
#CLAUDE_ARGS=--permission-mode plan

# Token and endpoint for Claude Code. Default: API_TOKEN and BASE_URL.
#ANTHROPIC_AUTH_TOKEN=
#ANTHROPIC_BASE_URL=https://openrouter.ai/api

# Models per CLI. Default: MODEL (stealth/ox-alpha) for every slot. The
# opus / sonnet / fable slots follow ANTHROPIC_MODEL when it is set. Point
# any of them at another OpenRouter id to mix models on one key.
#ANTHROPIC_MODEL=stealth/ox-alpha
#ANTHROPIC_DEFAULT_HAIKU_MODEL=stealth/ox-alpha
#CLAUDE_CODE_SUBAGENT_MODEL=stealth/ox-alpha
#OPENCODE_MODEL=stealth/ox-alpha
#OPENCODE_SMALL_MODEL=stealth/ox-alpha
#PI_MODEL=stealth/ox-alpha
#PI_SMALL_MODEL=stealth/ox-alpha

# Limits for SMALL_MODEL when it is a different size than MODEL.
# Default: CONTEXT_WINDOW / MAX_TOKENS.
#SMALL_CONTEXT_WINDOW=1048576
#SMALL_MAX_TOKENS=131072

# Claude Code's auto-compact window. Default: CONTEXT_WINDOW.
#CLAUDE_CODE_AUTO_COMPACT_WINDOW=1048576

# Marker appended to every Claude Code model slot (Claude Code-only syntax).
# Default: none. OpenRouter resolves ids itself and rejects the "[1m]" form.
#CLAUDE_MODEL_SUFFIX=[1m]
