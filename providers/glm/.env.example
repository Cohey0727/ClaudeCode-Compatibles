# GLM (Z.ai / Zhipu AI) settings. One file drives all three launchers:
# Claude Code, OpenCode and pi. Every setting below is generic; the
# commented-out lines further down are per-CLI overrides you only need when
# one CLI should differ from the rest.
# Reference: https://docs.z.ai/devpack/tool/claude

# Command names are derived from this: claude<NAME> / open<NAME> / pi<NAME>
# -> claudeglm, openglm, piglm.
NAME=glm

# Required: get an API key at https://z.ai/manage-apikey/apikey-list
API_TOKEN=

# Anthropic-compatible endpoint, shared by all three CLIs.
BASE_URL=https://api.z.ai/api/anthropic

# MODEL fills every main model slot, SMALL_MODEL every cheap one (Claude
# Code's haiku + subagent, OpenCode's small model, pi's second Ctrl+P entry).
MODEL=glm-5.2
SMALL_MODEL=glm-4.5-air

# Model limits: pi writes them into its generated models.json, and Claude
# Code takes CONTEXT_WINDOW as its auto-compact window. INPUT is "text" or
# "text,image"; REASONING says whether the models support extended thinking.
CONTEXT_WINDOW=1000000
MAX_TOKENS=131072
REASONING=true
INPUT=text

# glm-4.5-air is a much smaller model than glm-5.2, so it gets its own limits.
SMALL_CONTEXT_WINDOW=131072
SMALL_MAX_TOKENS=98304

# Default CLI options prepended to every launch (word-split). Applies to all
# three CLIs; per-CLI overrides are below.
ARGS=

# Claude Code extras, exported as-is.
CLAUDE_CODE_EFFORT_LEVEL=max

# --------------------------------------------------------------- overrides
# Everything below is optional — uncomment only to override the defaults
# derived from the settings above.

# Launcher command names. Default: claudeglm / openglm / piglm.
#COMMAND=claudeglm
#OPENCODE_COMMAND=openglm
#PI_COMMAND=piglm

# Default CLI options per launcher. Default: the value of ARGS.
#CLAUDE_ARGS=--permission-mode plan
#OPENCODE_ARGS=
#PI_ARGS=--thinking high

# Token and endpoint per launcher. Default: API_TOKEN and BASE_URL.
#ANTHROPIC_AUTH_TOKEN=
#ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic

# Models per launcher. Default: MODEL (glm-5.2) for the main slots,
# SMALL_MODEL (glm-4.5-air) for the cheap ones. The opus / sonnet / fable
# slots follow ANTHROPIC_MODEL when it is set.
#ANTHROPIC_MODEL=glm-5.2
#ANTHROPIC_DEFAULT_HAIKU_MODEL=glm-4.5-air
#CLAUDE_CODE_SUBAGENT_MODEL=glm-4.5-air
#OPENCODE_MODEL=glm-5.2
#OPENCODE_SMALL_MODEL=glm-4.5-air
#PI_MODEL=glm-5.2
#PI_SMALL_MODEL=glm-4.5-air

# Claude Code's auto-compact window. Default: CONTEXT_WINDOW.
#CLAUDE_CODE_AUTO_COMPACT_WINDOW=1000000

# Marker appended to every Claude Code model slot (Claude Code-only syntax).
# Default: none.
#CLAUDE_MODEL_SUFFIX=[1m]
