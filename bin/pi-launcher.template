#!/usr/bin/env bash
# Launch the pi coding agent against an Anthropic-compatible provider.
#
# Generated by `make setup`. The paths below are baked in from the directory
# you ran `make setup` from. Re-run `make setup` if you move the project.

set -euo pipefail

PROVIDER_DIR="@@PROVIDER_DIR@@"
COMMON="@@COMMON@@"
ENV_FILE="$PROVIDER_DIR/.env"
SELF="${0##*/}"

for f in "$COMMON" "$ENV_FILE"; do
  if [[ ! -f "$f" ]]; then
    echo "$SELF: file not found at $f" >&2
    echo "  re-run 'make setup' from the project root." >&2
    exit 1
  fi
done

# shellcheck disable=SC1090
source "$COMMON"

# The same .env drives all three launchers: one token, one endpoint, one
# model pair. ANTHROPIC_AUTH_TOKEN is exported below because the generated
# models.json refers to it by name.
load_settings "$ENV_FILE"
require_settings "$SELF" "$ENV_FILE"

if ! command -v pi >/dev/null 2>&1; then
  echo "$SELF: 'pi' is not on your PATH — install the pi coding agent first: https://pi.dev" >&2
  exit 1
fi

MODEL="${PI_MODEL:-$CFG_MODEL_PLAIN}"
MODEL="${MODEL%\[1m\]}"
SMALL_MODEL="${PI_SMALL_MODEL:-$CFG_SMALL_MODEL_PLAIN}"
SMALL_MODEL="${SMALL_MODEL%\[1m\]}"

# pi assumes 128k context / 16k output for models it does not know and caps
# each request at maxTokens/3, so both limits are always written out.
CONTEXT_WINDOW="${CFG_CONTEXT_WINDOW:-200000}"
MAX_TOKENS="${CFG_MAX_TOKENS:-32768}"
SMALL_CONTEXT_WINDOW="${CFG_SMALL_CONTEXT_WINDOW:-$CONTEXT_WINDOW}"
SMALL_MAX_TOKENS="${CFG_SMALL_MAX_TOKENS:-$MAX_TOKENS}"

REASONING="$CFG_REASONING"
if [[ "$REASONING" != "true" ]]; then REASONING=false; fi

case ",$CFG_INPUT," in
  *,image,*) INPUT='["text", "image"]' ;;
  *)         INPUT='["text"]' ;;
esac

PROVIDER_NAME="$(basename "$PROVIDER_DIR")"
PROVIDER_ID="$PROVIDER_NAME-anthropic"

model_entry() { # <model id> <context window> <max tokens>
  cat <<EOF
        {
          "id": "$1",
          "reasoning": $REASONING,
          "input": $INPUT,
          "contextWindow": $2,
          "maxTokens": $3
        }
EOF
}

MODELS_JSON=$(model_entry "$MODEL" "$CONTEXT_WINDOW" "$MAX_TOKENS")
if [[ "$SMALL_MODEL" != "$MODEL" ]]; then
  MODELS_JSON="$MODELS_JSON,
$(model_entry "$SMALL_MODEL" "$SMALL_CONTEXT_WINDOW" "$SMALL_MAX_TOKENS")"
fi

# pi reads models.json from its agent directory only, and PI_CODING_AGENT_DIR
# moves that whole directory — settings, auth, skills, prompts, themes and
# tools included. So the agent dir is mirrored here as symlinks and only
# models.json is replaced, leaving the global pi setup intact.
GLOBAL_AGENT_DIR="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}"
AGENT_DIR="$PROVIDER_DIR/.pi-agent"

mkdir -p "$AGENT_DIR"
shopt -s nullglob dotglob
# Drop links whose target disappeared from the global agent dir.
for link in "$AGENT_DIR"/*; do
  if [[ -L "$link" && ! -e "$link" ]]; then rm -f "$link"; fi
done
if [[ -d "$GLOBAL_AGENT_DIR" ]]; then
  for entry in "$GLOBAL_AGENT_DIR"/*; do
    base="${entry##*/}"
    if [[ "$base" != "models.json" ]]; then
      rm -rf "$AGENT_DIR/$base"
      ln -s "$entry" "$AGENT_DIR/$base"
    fi
  done
fi
shopt -u nullglob dotglob

# Regenerated on every launch so .env stays the single source of truth.
# Contains no secrets: "ANTHROPIC_AUTH_TOKEN" is the name of the environment
# variable pi reads the key from, not the key itself.
cat > "$AGENT_DIR/models.json" <<EOF
{
  "providers": {
    "$PROVIDER_ID": {
      "baseUrl": "$CFG_BASE_URL",
      "api": "anthropic-messages",
      "apiKey": "ANTHROPIC_AUTH_TOKEN",
      "models": [
$MODELS_JSON
      ]
    }
  }
}
EOF

# pi hands baseUrl to the Anthropic SDK, which appends "/v1/messages" — the
# same route Claude Code hits, so BASE_URL is used as-is.
export ANTHROPIC_AUTH_TOKEN="$CFG_TOKEN"
export PI_CODING_AGENT_DIR="$AGENT_DIR"
# Sessions belong to the user, not to a provider checkout.
export PI_CODING_AGENT_SESSION_DIR="${PI_CODING_AGENT_SESSION_DIR:-$GLOBAL_AGENT_DIR/sessions}"

MODEL_ARGS=(--model "$PROVIDER_ID/$MODEL")
if [[ "$SMALL_MODEL" != "$MODEL" ]]; then
  MODEL_ARGS+=(--models "$PROVIDER_ID/$MODEL,$PROVIDER_ID/$SMALL_MODEL")
fi

DEFAULT_ARGS="${PI_ARGS:-$CFG_ARGS}"
strip_metadata
strip_claude_env
unset ANTHROPIC_BASE_URL

# shellcheck disable=SC2086  # word-splitting DEFAULT_ARGS is intended
exec pi "${MODEL_ARGS[@]}" $DEFAULT_ARGS "$@"
