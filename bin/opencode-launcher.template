#!/usr/bin/env bash
# Launch OpenCode against an Anthropic-compatible provider.
#
# Generated by `make setup`. The PROVIDER_DIR path below is baked in
# from the directory you ran `make setup` from. Re-run `make setup`
# if you move the project.

set -euo pipefail

PROVIDER_DIR="@@PROVIDER_DIR@@"
ENV_FILE="$PROVIDER_DIR/.env"

if [[ ! -f "$ENV_FILE" ]]; then
  echo "launcher: env file not found at $ENV_FILE" >&2
  echo "  re-run 'make setup' from the project root." >&2
  exit 1
fi

# The .env is shared with the Claude Code launcher: the same
# ANTHROPIC_AUTH_TOKEN and ANTHROPIC_BASE_URL drive both. Everything is
# exported so the {env:ANTHROPIC_AUTH_TOKEN} reference in the generated
# config resolves inside opencode.
set -a
# shellcheck disable=SC1090
source "$ENV_FILE"
set +a

NAME="${OPENCODE_COMMAND:-launcher}"
DEFAULT_ARGS="${OPENCODE_ARGS:-}"

if ! command -v opencode >/dev/null 2>&1; then
  echo "$NAME: 'opencode' is not on your PATH — install OpenCode first: https://opencode.ai" >&2
  exit 1
fi

if [[ -z "${ANTHROPIC_AUTH_TOKEN:-}" ]]; then
  echo "$NAME: ANTHROPIC_AUTH_TOKEN is empty in $ENV_FILE" >&2
  echo "  edit the file and set your API key." >&2
  exit 1
fi

if [[ -z "${ANTHROPIC_BASE_URL:-}" ]]; then
  echo "$NAME: ANTHROPIC_BASE_URL is empty in $ENV_FILE" >&2
  exit 1
fi

# The AI SDK Anthropic provider appends "/messages" to its baseURL, while
# ANTHROPIC_BASE_URL is the Claude Code form that gets "/v1/messages"
# appended — so baseURL is ANTHROPIC_BASE_URL plus "/v1".
BASE_URL="$ANTHROPIC_BASE_URL"
while [[ "$BASE_URL" == */ ]]; do BASE_URL="${BASE_URL%/}"; done
BASE_URL="$BASE_URL/v1"

# "[1m]" is a Claude Code-only marker; OpenCode sends model ids verbatim.
MODEL="${OPENCODE_MODEL:-${ANTHROPIC_MODEL:-}}"
MODEL="${MODEL%\[1m\]}"
SMALL_MODEL="${OPENCODE_SMALL_MODEL:-${CLAUDE_CODE_SUBAGENT_MODEL:-}}"
SMALL_MODEL="${SMALL_MODEL%\[1m\]}"
SMALL_MODEL="${SMALL_MODEL:-$MODEL}"

if [[ -z "$MODEL" ]]; then
  echo "$NAME: neither OPENCODE_MODEL nor ANTHROPIC_MODEL is set in $ENV_FILE" >&2
  exit 1
fi

PROVIDER_NAME="$(basename "$PROVIDER_DIR")"
PROVIDER_ID="$PROVIDER_NAME-anthropic"

if [[ "$SMALL_MODEL" == "$MODEL" ]]; then
  MODELS_JSON="        \"$MODEL\": {}"
else
  MODELS_JSON="        \"$MODEL\": {},
        \"$SMALL_MODEL\": {}"
fi

# Regenerated on every launch so .env stays the single source of truth.
# Contains no secrets: the token is injected via {env:...} at runtime.
CONFIG_FILE="$PROVIDER_DIR/.opencode.json"
cat > "$CONFIG_FILE" <<EOF
{
  "\$schema": "https://opencode.ai/config.json",
  "provider": {
    "$PROVIDER_ID": {
      "npm": "@ai-sdk/anthropic",
      "name": "$PROVIDER_NAME (Anthropic-compatible)",
      "options": {
        "baseURL": "$BASE_URL",
        "apiKey": "{env:ANTHROPIC_AUTH_TOKEN}"
      },
      "models": {
$MODELS_JSON
      }
    }
  },
  "model": "$PROVIDER_ID/$MODEL",
  "small_model": "$PROVIDER_ID/$SMALL_MODEL"
}
EOF
export OPENCODE_CONFIG="$CONFIG_FILE"

# COMMAND / CLAUDE_ARGS belong to the Claude Code launcher; OPENCODE_COMMAND
# and OPENCODE_ARGS are this launcher's metadata (consumed above). None of
# them are for opencode's env.
unset COMMAND CLAUDE_ARGS OPENCODE_COMMAND OPENCODE_ARGS OPENCODE_MODEL OPENCODE_SMALL_MODEL

# A stale ANTHROPIC_API_KEY would activate OpenCode's builtin Anthropic
# provider on top of the one configured above.
unset ANTHROPIC_API_KEY

# shellcheck disable=SC2086  # word-splitting DEFAULT_ARGS is intended
exec opencode $DEFAULT_ARGS "$@"
