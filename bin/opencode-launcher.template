#!/usr/bin/env bash
# Launch OpenCode against an Anthropic-compatible provider.
#
# Generated by `make setup`. The paths below are baked in from the directory
# you ran `make setup` from. Re-run `make setup` if you move the project.

set -euo pipefail

PROVIDER_DIR="@@PROVIDER_DIR@@"
COMMON="@@COMMON@@"
ENV_FILE="$PROVIDER_DIR/.env"
SELF="${0##*/}"

for f in "$COMMON" "$ENV_FILE"; do
  if [[ ! -f "$f" ]]; then
    echo "$SELF: file not found at $f" >&2
    echo "  re-run 'make setup' from the project root." >&2
    exit 1
  fi
done

# shellcheck disable=SC1090
source "$COMMON"

# The same .env drives all three launchers: one token, one endpoint, one
# model pair.
load_settings "$ENV_FILE"
require_settings "$SELF" "$ENV_FILE"

if ! command -v opencode >/dev/null 2>&1; then
  echo "$SELF: 'opencode' is not on your PATH — install OpenCode first: https://opencode.ai" >&2
  exit 1
fi

# The AI SDK Anthropic provider appends "/messages" to its baseURL, while
# BASE_URL is the Claude Code form that gets "/v1/messages" appended — so
# baseURL is BASE_URL plus "/v1".
BASE_URL="$CFG_BASE_URL/v1"

MODEL="${OPENCODE_MODEL:-$CFG_MODEL_PLAIN}"
MODEL="${MODEL%\[1m\]}"
SMALL_MODEL="${OPENCODE_SMALL_MODEL:-$CFG_SMALL_MODEL_PLAIN}"
SMALL_MODEL="${SMALL_MODEL%\[1m\]}"

PROVIDER_NAME="$(basename "$PROVIDER_DIR")"
PROVIDER_ID="$PROVIDER_NAME-anthropic"

if [[ "$SMALL_MODEL" == "$MODEL" ]]; then
  MODELS_JSON="        \"$MODEL\": {}"
else
  MODELS_JSON="        \"$MODEL\": {},
        \"$SMALL_MODEL\": {}"
fi

# Regenerated on every launch so .env stays the single source of truth.
# Contains no secrets: the token is injected via {env:...} at runtime.
CONFIG_FILE="$PROVIDER_DIR/.opencode.json"
cat > "$CONFIG_FILE" <<EOF
{
  "\$schema": "https://opencode.ai/config.json",
  "provider": {
    "$PROVIDER_ID": {
      "npm": "@ai-sdk/anthropic",
      "name": "$PROVIDER_NAME (Anthropic-compatible)",
      "options": {
        "baseURL": "$BASE_URL",
        "apiKey": "{env:ANTHROPIC_AUTH_TOKEN}"
      },
      "models": {
$MODELS_JSON
      }
    }
  },
  "model": "$PROVIDER_ID/$MODEL",
  "small_model": "$PROVIDER_ID/$SMALL_MODEL"
}
EOF
export OPENCODE_CONFIG="$CONFIG_FILE"

# Everything opencode itself needs: the token the generated config points at.
export ANTHROPIC_AUTH_TOKEN="$CFG_TOKEN"

DEFAULT_ARGS="${OPENCODE_ARGS:-$CFG_ARGS}"
strip_metadata
strip_claude_env

# A stale ANTHROPIC_API_KEY would activate OpenCode's builtin Anthropic
# provider on top of the one configured above.
unset ANTHROPIC_API_KEY ANTHROPIC_BASE_URL

# shellcheck disable=SC2086  # word-splitting DEFAULT_ARGS is intended
exec opencode $DEFAULT_ARGS "$@"
