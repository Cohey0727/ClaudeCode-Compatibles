#!/usr/bin/env bash
# Launch Claude Code against an Anthropic-compatible provider.
#
# Generated by `make setup`. The paths below are baked in from the directory
# you ran `make setup` from. Re-run `make setup` if you move the project.

set -euo pipefail

PROVIDER_DIR="@@PROVIDER_DIR@@"
COMMON="@@COMMON@@"
ENV_FILE="$PROVIDER_DIR/.env"
SELF="${0##*/}"

for f in "$COMMON" "$ENV_FILE"; do
  if [[ ! -f "$f" ]]; then
    echo "$SELF: file not found at $f" >&2
    echo "  re-run 'make setup' from the project root." >&2
    exit 1
  fi
done

# shellcheck disable=SC1090
source "$COMMON"

# .env is the single source of truth: its generic settings become the
# ANTHROPIC_* / CLAUDE_CODE_* variables Claude Code itself reads, and any
# extra KEY=VALUE pairs are exported verbatim.
load_settings "$ENV_FILE"
require_settings "$SELF" "$ENV_FILE"

export ANTHROPIC_AUTH_TOKEN="$CFG_TOKEN"
export ANTHROPIC_BASE_URL="$CFG_BASE_URL"

# CLAUDE_MODEL_SUFFIX appends a Claude Code-only marker such as "[1m]" to
# every model slot. A model id that already carries one is left alone.
if [[ -n "${CLAUDE_MODEL_SUFFIX:-}" ]]; then
  MODEL="$CFG_MODEL_PLAIN$CLAUDE_MODEL_SUFFIX"
  SMALL_MODEL="$CFG_SMALL_MODEL_PLAIN$CLAUDE_MODEL_SUFFIX"
else
  MODEL="$CFG_MODEL"
  SMALL_MODEL="$CFG_SMALL_MODEL"
fi

export ANTHROPIC_MODEL="${ANTHROPIC_MODEL:-$MODEL}"
export ANTHROPIC_DEFAULT_OPUS_MODEL="${ANTHROPIC_DEFAULT_OPUS_MODEL:-$ANTHROPIC_MODEL}"
export ANTHROPIC_DEFAULT_SONNET_MODEL="${ANTHROPIC_DEFAULT_SONNET_MODEL:-$ANTHROPIC_MODEL}"
export ANTHROPIC_DEFAULT_FABLE_MODEL="${ANTHROPIC_DEFAULT_FABLE_MODEL:-$ANTHROPIC_MODEL}"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="${ANTHROPIC_DEFAULT_HAIKU_MODEL:-$SMALL_MODEL}"
export CLAUDE_CODE_SUBAGENT_MODEL="${CLAUDE_CODE_SUBAGENT_MODEL:-$SMALL_MODEL}"

# The context window doubles as Claude Code's auto-compact threshold.
if [[ -n "$CFG_CONTEXT_WINDOW" ]]; then
  export CLAUDE_CODE_AUTO_COMPACT_WINDOW="${CLAUDE_CODE_AUTO_COMPACT_WINDOW:-$CFG_CONTEXT_WINDOW}"
fi

DEFAULT_ARGS="${CLAUDE_ARGS:-$CFG_ARGS}"
strip_metadata

# A stale ANTHROPIC_API_KEY in the environment would shadow AUTH_TOKEN.
unset ANTHROPIC_API_KEY

# shellcheck disable=SC2086  # word-splitting DEFAULT_ARGS is intended
exec claude $DEFAULT_ARGS "$@"
