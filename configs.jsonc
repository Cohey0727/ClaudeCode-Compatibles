// Every provider: its endpoint, the models it serves, and the tags naming the
// slot each model fills. "${NAME}" and "${NAME:-fallback}" resolve from the
// .env beside this file, so no secret is written here. Fields: see README.
{
  // Deep-merged, key by key, into the generated opencode.json last, so a key
  // here wins. A "${NAME}" here is asked for by `make setup` and reaches
  // opencode.json as a {file:...} reference to a copy of its .env value.
  "opencode": {
    "overrides": {
      "model": "opencode-go/deepseek-v4.1-flash",
      "small_model": "opencode-go/deepseek-v4.1-flash",

      // Command Code's Provider API cannot be a provider below: every provider
      // there is served over Anthropic Messages to every CLI, and Command Code
      // answers only Claude on /messages — everything else only on
      // /chat/completions, with a 400 for the wrong one. "context" is the
      // model's context_length in GET /provider/v1/models; without one
      // OpenCode never compacts. "output" is only a ceiling, and OpenCode caps
      // it at 32000 anyway.
      "provider": {
        "commandcode-openai": {
          "npm": "@ai-sdk/openai-compatible",
          "name": "Subscriptions",
          "options": {
            "baseURL": "https://api.commandcode.ai/provider/v1",
            "apiKey": "${COMMAND_CODE_API_KEY}"
          },
          "models": {
            "deepseek/deepseek-v4.1-flash": { "name": "Command Code deepseek/deepseek-v4.1-flash", "limit": { "context": 1000000, "output": 32000 } },
            "moonshotai/Kimi-K3": { "name": "Command Code moonshotai/Kimi-K3", "limit": { "context": 1000000, "output": 32000 } },
            "z-ai/glm-5.3-flash": { "name": "Command Code z-ai/glm-5.3-flash", "limit": { "context": 1048576, "output": 32000 } },

            "gpt-5.6-sol": { "name": "Command Code gpt-5.6-sol", "limit": { "context": 1050000, "output": 32000 } },
            "gpt-5.6-terra": { "name": "Command Code gpt-5.6-terra", "limit": { "context": 1050000, "output": 32000 } },
            "gpt-5.6-luna": { "name": "Command Code gpt-5.6-luna", "limit": { "context": 1050000, "output": 32000 } },
            "gpt-5.3-codex": { "name": "Command Code gpt-5.3-codex", "limit": { "context": 400000, "output": 32000 } },
            "deepseek/deepseek-v4-pro": { "name": "Command Code deepseek/deepseek-v4-pro", "limit": { "context": 1000000, "output": 32000 } },
            "zai-org/GLM-5.3": { "name": "Command Code zai-org/GLM-5.3", "limit": { "context": 1000000, "output": 32000 } },
            "MiniMaxAI/MiniMax-M3": { "name": "Command Code MiniMaxAI/MiniMax-M3", "limit": { "context": 1000000, "output": 32000 } },
            "Qwen/Qwen3.8-Max": { "name": "Command Code Qwen/Qwen3.8-Max", "limit": { "context": 1000000, "output": 32000 } },
            "xiaomi/mimo-v2.5-pro": { "name": "Command Code xiaomi/mimo-v2.5-pro", "limit": { "context": 1000000, "output": 32000 } },
            "google/gemini-3.8-flash": { "name": "Command Code google/gemini-3.8-flash", "limit": { "context": 1000000, "output": 32000 } },
            "xai/grok-4.6": { "name": "Command Code xai/grok-4.6", "limit": { "context": 500000, "output": 32000 } },
            "meta/muse-spark-1.3": { "name": "Command Code meta/muse-spark-1.3", "limit": { "context": 1048576, "output": 32000 } },
            "sakana/fugu-ultra": { "name": "Command Code sakana/fugu-ultra", "limit": { "context": 1000000, "output": 32000 } },
            "nvidia/nemotron-3-ultra-550b-a55b": { "name": "Command Code nvidia/nemotron-3-ultra-550b-a55b", "limit": { "context": 1000000, "output": 32000 } },

            "meituan/LongCat-2.0:free": { "name": "Command Code meituan/LongCat-2.0:free", "limit": { "context": 1048576, "output": 32000 } },
            "poolside/laguna-s-2.1-free": { "name": "Command Code poolside/laguna-s-2.1-free", "limit": { "context": 256000, "output": 32000 } },
            "inclusionai/ling-3.0-flash-sante:free": { "name": "Command Code inclusionai/ling-3.0-flash-sante:free", "limit": { "context": 262144, "output": 32000 } }
          }
        },
        "commandcode-anthropic": {
          "npm": "@ai-sdk/anthropic",
          "name": "Subscriptions",
          "options": {
            "baseURL": "https://api.commandcode.ai/provider/v1",
            "apiKey": "${COMMAND_CODE_API_KEY}"
          },
          "models": {
            "claude-fable-5-1": { "name": "Command Code claude-fable-5-1", "limit": { "context": 1000000, "output": 32000 } },
            "claude-opus-5": { "name": "Command Code claude-opus-5", "limit": { "context": 1000000, "output": 32000 } },
            "claude-sonnet-5": { "name": "Command Code claude-sonnet-5", "limit": { "context": 1000000, "output": 32000 } },
            "claude-haiku-4-5-20251001": { "name": "Command Code claude-haiku-4-5-20251001", "limit": { "context": 200000, "output": 32000 } }
          }
        }
      }
    }
  },

  "providers": {

    "deepseek": {
      "label": "DeepSeek",
      "API_KEY": "${DEEPSEEK_API_KEY}",
      "BASE_URL": "${DEEPSEEK_BASE_URL:-https://api.deepseek.com/anthropic}",

      "defaults": {
        "context_window": 1000000,
        "max_tokens": 384000,
        "reasoning": true,
        "input": ["text"]
      },

      "claude": { "env": { "CLAUDE_CODE_EFFORT_LEVEL": "max" } },

      "models": [
        { "id": "deepseek-v4-pro", "tags": ["default"] },
        { "id": "deepseek-flash", "tags": ["small"] }
      ]
    },

    "glm": {
      "label": "Z.AI",
      "API_KEY": "${GLM_API_KEY}",
      "BASE_URL": "${GLM_BASE_URL:-https://api.z.ai/api/anthropic}",

      "defaults": {
        "context_window": 1000000,
        "max_tokens": 131072,
        "reasoning": true,
        "input": ["text"]
      },

      "claude": { "env": { "CLAUDE_CODE_EFFORT_LEVEL": "max" } },

      "models": [
        // The "[1m]" ids exist only on the coding-plan route; this BASE_URL
        // rejects them with "modelCode: does not exist".
        { "id": "glm-5.3", "tags": ["default"] },
        { "id": "glm-5.3-flash", "tags": ["small"] }
      ]
    },

    "kimi": {
      "label": "Moonshot",
      "API_KEY": "${KIMI_API_KEY}",
      "BASE_URL": "${KIMI_BASE_URL:-https://api.kimi.com/coding}",

      "defaults": {
        "context_window": 1048576,
        "max_tokens": 131072,
        "reasoning": true,
        "input": ["text", "image"]
      },

      "claude": {
        "env": {
          "CLAUDE_CODE_EFFORT_LEVEL": "max",
          "ENABLE_TOOL_SEARCH": "false"
        }
      },

      "models": [
        { "id": "kimi-k3", "claude_id": "kimi-k3[1m]", "tags": ["default", "small"] }
      ]
    },

    "local": {
      "label": "Local",
      // llama-server takes no auth, but the CLIs require a non-empty value.
      "API_KEY": "${LOCAL_API_KEY:-local}",
      "BASE_URL": "${LOCAL_BASE_URL:-http://127.0.0.1:11301}",

      "claude": { "env": { "CLAUDE_CODE_EFFORT_LEVEL": "low" } },

      "models": [
        // llama-server answers with whatever it has loaded and ignores the id,
        // so a fixed one survives swapping the model. context_window must stay
        // at or below the server's --ctx-size.
        {
          "id": "default",
          "tags": ["default", "small"],
          "context_window": 262144,
          "max_tokens": 32768,
          "reasoning": true,
          "input": ["text"]
        }
      ]
    },

    "gtr": {
      "label": "GTR9",
      // llama-server takes no auth unless started with --api-key, but the CLIs
      // require a non-empty value.
      "API_KEY": "${GTR_API_KEY:-gtr}",
      "BASE_URL": "${GTR_BASE_URL:-https://gtr-llama.spaghetti-monster.com}",

      // Cloudflare Access answers a request without these with a 302 to its
      // login page.
      "REQUEST_HEADERS": {
        "CF-Access-Client-Id": "${GTR_CF_ACCESS_CLIENT_ID}",
        "CF-Access-Client-Secret": "${GTR_CF_ACCESS_CLIENT_SECRET}"
      },

      "claude": { "env": { "CLAUDE_CODE_EFFORT_LEVEL": "low" } },

      "opencode": {
        // The window a session may grow into before OpenCode compacts it, not
        // the server's capacity: this server needs minutes to prefill more.
        "context_window": 16384,
        "max_tokens": 4096
      },

      "models": [
        // As with "local", the id is a label and context_window must stay at or
        // below the server's --ctx-size.
        {
          "id": "default",
          "tags": ["default", "small"],
          "context_window": 262144,
          "max_tokens": 32768,
          "reasoning": true,
          "input": ["text"]
        }
      ]
    }
  }
}
